<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permission matrix: docs/04-android-platform-notes.md §3 -->

    <!-- Network: Deepgram / OpenAI / on-device model download -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Legacy BLE (API <= 30). On 31+ these are replaced by the BLUETOOTH_* runtime
         permissions below, so they are capped to keep them off modern devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <!-- Legacy BLE scan needed location up to API 30. On 31+ the scan declares
         neverForLocation, so location is not requested at all. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>

    <!-- BLE on API >= 31. neverForLocation keeps the scan out of the location bucket. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- Phone-mic transcription mode only; requested lazily. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Runtime permission on API >= 33; covers the foreground-service notification too. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Foreground session service; the <service> element is declared inside <application>. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>

    <!-- Partial wake lock while a session is listening. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Haptic feedback. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Keeps the BLE link alive in Doze; offered with an explanation, never silently. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- Exact task reminders, opt-in only (LO-50). Declaring it does not grant it:
         Android 14+ denies SCHEDULE_EXACT_ALARM by default to apps targeting API 33+,
         so the user turns it on from Settings > Alarms & reminders and the app falls
         back to an inexact alarm whenever it is not granted. USE_EXACT_ALARM is
         deliberately NOT declared — Play policy restricts it to alarm-clock and
         calendar apps. See docs/04-android-platform-notes.md §3 and §6. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- flutter_foreground_task's own manifest declares RECEIVE_BOOT_COMPLETED for its
         optional boot receiver. A boot receiver is explicitly out of scope for v1
         (docs/03-architecture.md §5) and the service is configured with
         autoRunOnBoot: false, so the permission is merged out instead of being shipped
         unused. Drop this block if boot start is ever adopted. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove"/>

    <!-- Auto Backup stays on (default allowBackup=true) because the conversation
         database is worth restoring; the API keys are not. Both rule files carve the
         credential-bearing SharedPreferences files out of backup and device transfer.
         fullBackupContent covers API <= 30, dataExtractionRules API 31+; Android picks
         one by version, so both have to say the same thing. See
         docs/04-android-platform-notes.md §9 (LO-25). -->
    <application
        android:label="LibreOmi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Small status-bar icon for the persistent session notification. The
             foreground-service plugin resolves the drawable through this meta-data entry
             (AndroidForegroundRunner.iconMetaDataName), not by resource name. -->
        <meta-data
            android:name="org.libreomi.app.NOTIFICATION_ICON"
            android:resource="@drawable/ic_notification"/>

        <!-- Foreground service that keeps the Flutter main isolate alive while a session
             records (docs/04-android-platform-notes.md §4). The class is the one shipped by
             flutter_foreground_task; both types are declared here because the session picks
             them per run: an Omi BLE session uses connectedDevice only, a phone-mic session
             uses connectedDevice|microphone. On Android 14+ a microphone-type service may
             only be started while the app is in the foreground, so the phone-mic session is
             always started from a UI action. stopWithTask keeps the service from outliving
             the app task: a restarted service would carry a notification with no session
             behind it. It is set here and NOT through the plugin's Dart option of the same
             name — that variant also stops the service whenever no activity is resumed,
             which would kill every session at screen-off (see docs/04 §4). -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="connectedDevice|microphone"
            android:stopWithTask="true"
            android:exported="false"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
