<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status-bar icon for awesome_notifications.
     Android tints the small icon itself, so every element is opaque white on a
     transparent background; anything else renders as a white square. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Microphone capsule: two semicircles of radius 3 joined by straight sides. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,6 a3,3 0 0 1 6,0 v6 a3,3 0 0 1 -6,0 z" />

    <!-- Cradle: half circle of radius 5 below the capsule. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M7,11 v1 a5,5 0 0 0 10,0 v-1" />

    <!-- Stand and base. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,17 v3" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M8.5,20 h7" />
</vector>
