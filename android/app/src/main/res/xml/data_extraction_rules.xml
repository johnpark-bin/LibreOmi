<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-to-device transfer rules for Android 12 and above
  (android:dataExtractionRules). Same exclusions as `backup_rules.xml`, which
  covers Android 11 and below; see the rationale there and in
  docs/04-android-platform-notes.md §9.

  Both transfer types are spelled out because they are independent: omitting a
  section would leave that path backing up everything.

  `path="models"` (LO-40) excludes `getApplicationSupportDirectory()/models/`,
  where `transcription/model_store.dart` installs on-device speech models
  (`file` domain: `PathUtils.getFilesDir()` on Android). Those are ~90-290 MB of
  re-downloadable weights per model; backing them up would blow the backup
  quota for data a tap in Settings → Models fetches again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="models"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="models"/>
    </device-transfer>
</data-extraction-rules>
