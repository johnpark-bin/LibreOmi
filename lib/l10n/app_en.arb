  "permissionsRationale_collectsHeader": "What LibreOmi collects",
  "@permissionsRationale_collectsHeader": {
    "description": "Play Store prominent-disclosure screen: section header. Wording is pinned to docs/08-dev-workflow.md §8 and must not be reworded."
  },
  "permissionsRationale_collectsBody": "Audio captured from your Omi wearable or your phone's microphone while a capture is running, and the transcripts, conversations, memories and tasks derived from it.",
  "@permissionsRationale_collectsBody": {
    "description": "Play Store prominent-disclosure screen: what data the app collects. Wording is pinned to docs/08-dev-workflow.md §8 and must not be reworded."
  },
  "permissionsRationale_whereGoesHeader": "Where it goes",
  "@permissionsRationale_whereGoesHeader": {
    "description": "Play Store prominent-disclosure screen: section header. Wording is pinned to docs/08-dev-workflow.md §8 and must not be reworded."
  },
  "permissionsRationale_whereGoesBody": "There is no LibreOmi server and no account. Speech is transcribed either entirely on your phone (on-device model) or, if you enter a Deepgram API key, by sending audio to Deepgram. Conversation text is sent to the LLM endpoint you configure only when you supply a key for it. With no keys entered, no capture is sent to any service.",
  "@permissionsRationale_whereGoesBody": {
    "description": "Play Store prominent-disclosure screen: where captured data is sent. Wording is pinned to docs/08-dev-workflow.md §8 and must not be reworded."
  },
  "permissionsRationale_whereStoredHeader": "Where it is stored",
  "@permissionsRationale_whereStoredHeader": {
    "description": "Play Store prominent-disclosure screen: section header. Wording is pinned to docs/08-dev-workflow.md §8 and must not be reworded."
  },
  "permissionsRationale_whereStoredBody": "Conversations, memories, tasks and chat history live in a SQLite database in the app's private storage. Recordings synced from the wearable's SD card are kept as audio files alongside it until you delete them. API keys are stored encrypted, under a key that never leaves the Android keystore.\n\nAndroid's automatic backup is left on, so the database and any synced recordings are included in your Google account backup. Your API keys and the downloaded speech models are excluded from it.",
  "@permissionsRationale_whereStoredBody": {
    "description": "Play Store prominent-disclosure screen: where data is stored, and what automatic backup covers. Wording is pinned to docs/08-dev-workflow.md §8 and must not be reworded."
  },
  "permissionsRationale_yourControlHeader": "Your control",
  "@permissionsRationale_yourControlHeader": {
    "description": "Play Store prominent-disclosure screen: section header. Wording is pinned to docs/08-dev-workflow.md §8 and must not be reworded."
  },
  "permissionsRationale_yourControlBody": "Settings → Data → Export All Data writes your conversations, memories, tasks and chat history to a JSON file; Import from Backup reads one back. Deleting the app, or clearing its data in Android settings, removes everything on the device, audio files included.",
  "@permissionsRationale_yourControlBody": {
    "description": "Play Store prominent-disclosure screen: how the user exports, imports or erases their data. Wording is pinned to docs/08-dev-workflow.md §8 and must not be reworded."
  },
  "permissionsRationale_permissionsHeader": "Permissions",
  "@permissionsRationale_permissionsHeader": {
    "description": "Play Store prominent-disclosure screen: section header over the per-permission cards"
  },
  "permissionsRationale_bluetoothTitleLegacy": "Bluetooth (location permission)",
  "@permissionsRationale_bluetoothTitleLegacy": {
    "description": "Permission-row title on Android 11 and older, where Bluetooth scanning requires the location permission"
  },
  "permissionsRationale_bluetoothTitle": "Bluetooth",
